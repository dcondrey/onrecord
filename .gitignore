# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Signing keys — the private key never leaves the machine that made it
keys/

# Env & secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Cached GIS source data for scripts/sync-geo.mjs (large, refetchable)
.gis-cache/

# Internal withdrawal log (id/zone/category/timestamp only, never the story) —
# deliberately not committed: the whole point of `on-record withdraw` is that
# the entry is gone from the public record, not relocated into git history.
data/withdrawn.json

# SMS gateway review queue — signed but unreviewed contributor submissions
# (src/gateway/sms.ts). Not committed for the same reason: it holds real
# story content that has not cleared review, unlike data/entries.json.
data/pending-review.json
