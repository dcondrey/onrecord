{
  "name": "on-record",
  "version": "1.0.0",
  "private": true,
  "description": "Backend companion to the On Record artifact: Claude-dignified stories, ECDSA-signed entries, C2PA-style provenance manifests.",
  "type": "module",
  "bin": {
    "on-record": "./dist/cli.js"
  },
