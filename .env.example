# Required for `on-record add` (the Claude transform step).
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-4-8.
# Also valid: claude-opus-5 (current flagship), claude-sonnet-5 (cheaper/faster).
ONRECORD_MODEL=claude-opus-4-8

# Optional C2PA archive signing. Generate development credentials with
# `npm run c2pa:dev-cert`; production requires a CA-issued C2PA certificate.
ONRECORD_C2PA_CERT=keys/c2pa-chain.pem
ONRECORD_C2PA_KEY=keys/c2pa-key.pem

# Optional publisher identity. Defaults to a self-contained did:key.
ONRECORD_ISSUER_DID=did:web:example.org
